{
  "name": "twynix-hmi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n gateway,editor -c cyan,green \"npm:dev:gateway\" \"npm:dev:editor\"",
    "dev:editor": "ng serve editor --host 127.0.0.1 --port 4200",
    "dev:gateway": "tsx watch apps/gateway/src/main.ts",
    "build": "npm run build:editor && npm run build:gateway",
    "build:editor": "ng build editor",
    "build:gateway": "tsc -p apps/gateway/tsconfig.json",
    "typecheck": "npm run typecheck:gateway && npm run typecheck:editor && npm run typecheck:tests && npm run typecheck:tooling",
    "test": "npm run build:gateway && node --import tsx --test tests/*.test.ts",
    "start:gateway": "node --env-file-if-exists=.env dist/gateway/apps/gateway/src/main.js",
    "format": "prettier --write apps packages tests docs README.md *.json compose.yaml",
    "typecheck:gateway": "tsc --noEmit -p apps/gateway/tsconfig.json --rootDir .",
    "typecheck:editor": "tsc --noEmit -p apps/editor/tsconfig.json --rootDir .",
    "typecheck:tests": "tsc --noEmit -p tests/tsconfig.json --rootDir .",
    "typecheck:tooling": "tsc --noEmit -p tsconfig.tooling.json --rootDir .",
    "lint": "eslint apps packages tests scripts playwright*.config.ts eslint.config.mjs --max-warnings=0",
    "format:check": "prettier --check apps packages tests scripts docs .github AGENTS.md CLAUDE.md README.md package.json package-lock.json angular.json tsconfig.json tsconfig.tooling.json eslint.config.mjs playwright.config.ts compose.yaml .agents/skills CONTRIBUTING.md SECURITY.md STARTUP_PROMPT.md CHANGELOG.md project.json foundation.json",
    "test:smoke": "playwright test",
    "test:postgres": "node scripts/engineering/postgres-tests.mjs",
    "benchmark": "node --import tsx scripts/engineering/benchmark.ts",
    "verify": "node scripts/engineering/verify.mjs",
    "test:performance": "playwright test --config=playwright.performance.config.ts",
    "benchmark:scripting": "node --import tsx scripts/engineering/scripting-benchmark.ts"
  },
  "dependencies": {
    "@angular/common": "22.2.6",
    "@angular/compiler": "22.2.6",
    "@angular/core": "22.2.6",
    "@angular/forms": "22.2.6",
    "@angular/platform-browser": "22.2.6",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.0",
    "quickjs-emscripten": "^0.31.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.6",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/ws": "^8.18.0",
    "concurrently": "^9.2.0",
    "eslint": "10.15.0",
    "prettier": "^3.10.1",
    "tsx": "^4.20.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "8.72.2"
  },
  "engines": {
    "node": "22.22.3"
  }
}
